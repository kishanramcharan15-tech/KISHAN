mathematical operators 
int a = 12, b = 5;
System.out.println("a + b = " + (a + b)); // Addition: 17
System.out.println("a - b = " + (a - b)); // Subtraction: 7
System.out.println("a * b = " + (a * b)); // Multiplication: 60
System.out.println("a / b = " + (a / b)); // Division: 2 (integer division)
System.out.println("a % b = " + (a % b)); // Modulo: 2

